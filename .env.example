TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_CHAT_ID=-1001234567890
TELEGRAM_ADMIN_ID=123456789
TELEGRAM_ADMIN_USERNAME=username_without_at

# Supabase/Postgres runtime DSN. For IPv4-only hosts use the Supavisor session pooler:
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
# Optional SQLite fallback / migration source.
DATABASE_PATH=data/app.sqlite3
BRANDS_FILE=brands.yaml
POLL_INTERVAL_SECONDS=60

GOOFISH_ENABLED=true
GOOFISH_STORAGE_STATE=state/goofish.json
GOOFISH_STORAGE_STATE_JSON=
GOOFISH_HEADLESS=true

GRAILED_ENABLED=true
GRAILED_STORAGE_STATE=state/grailed.json
GRAILED_STORAGE_STATE_JSON=
GRAILED_EMAIL=
GRAILED_PASSWORD=
GRAILED_HEADLESS=true

# Optional proxies. Format: http://user:pass@host:port (or socks5://...).
# PROXY_URL is used as a fallback for both parsers if the per-source one is empty.
PROXY_URL=
GRAILED_PROXY_URL=
GOOFISH_PROXY_URL=

PARSER_TIMEOUT_MS=30000
MAX_ITEMS_PER_SOURCE=12
MAX_SENDS_PER_RUN=8
LOG_FILE=logs/app.log

CAPROVER_URL=https://captain.example.com
CAPROVER_APP=china-bot
CAPROVER_APP_TOKEN=replace_me

SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_PASSWORD=
